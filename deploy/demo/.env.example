FUSESCOPE_VERSION=0.159.0
# The schema migrator's image; the collector is FUSESCOPE_COLLECTOR_IMAGE.
COLLECTOR_VERSION=0.145.0
FUSESCOPE_COLLECTOR_IMAGE=ghcr.io/fuseone-io/fusescope-collector:0.2.0@sha256:b9f8b298703d65452a9314ce9007473a6164adfc3fa56e65d97cf136f90322f3
FUSESCOPE_HOST=fusescope.example.com
FUSESCOPE_URL=https://fusescope.example.com
# internal (self-signed) or origin (certs/origin.pem + certs/origin.key)
FUSESCOPE_TLS=internal
CADDY_PORT=8443
# Default retention of logs, traces and metrics on a fresh install; never overrides Settings › Retention.
RETENTION_DAYS=3
# Generated by install.sh.
JWT_SECRET=
ADMIN_EMAIL=admin@fusescope.example.com
DEMO_EMAIL=demo@fusescope.example.com
# Written by install.sh once the RUM application exists.
RUM_APPLICATION_ID=
RUM_PUBLIC_KEY=
RUM_REACT_APPLICATION_ID=
RUM_REACT_PUBLIC_KEY=
# Where the samples' browsers send RUM; empty, FUSESCOPE_URL (Caddy, then the collector).
RUM_ENDPOINT=
FUSESCOPE_BROWSER_VERSION=next
RUM_DRIVER_SESSIONS=3
RUM_DRIVER_INTERVAL_SECONDS=300
