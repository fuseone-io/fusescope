ARG ALPINE_SHA="pass-a-valid-docker-sha-otherwise-this-will-fail"

FROM alpine@sha256:${ALPINE_SHA}
LABEL maintainer="fuseone"
WORKDIR /root

ARG OS="linux"
ARG ARCH

RUN apk update && \
    apk add ca-certificates && \
    rm -rf /var/cache/apk/*

COPY ./target/${OS}-${ARCH}/fusescope /root/fusescope
COPY ./templates /root/templates
COPY frontend/build/ /etc/signoz/web/

RUN chmod 755 /root /root/fusescope

ENTRYPOINT ["./fusescope", "server"]
